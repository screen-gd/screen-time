{
  "name": "tally-screen-time",
  "productName": "Tally",
  "version": "1.2.2",
  "description": "Local screen-time tracker: which app and which website took your day.",
  "author": "Screen",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "node scripts/build-native.js && npm run backend:build && electron .",
    "demo": "electron . --demo",
    "native": "node scripts/build-native.js",
    "backend:build": "node scripts/build-backend.js",
    "backend:start": "node scripts/build-backend.js && node scripts/run-backend.js",
    "benchmark": "node scripts/benchmark.js",
    "make-icons": "node scripts/make-icons.js",
    "icons": "node scripts/fetch-icons.js",
    "dither": "node scripts/make-dither.js",
    "check": "node scripts/koffi-test.js",
    "test": "node scripts/tracker-test.js",
    "dist": "node scripts/build-native.js && npm run backend:build && electron-builder --win nsis --publish never",
    "dist:dir": "node scripts/build-native.js && npm run backend:build && electron-builder --dir",
    "dist:mac": "node scripts/build-native.js && npm run backend:build && electron-builder --mac --publish never",
    "dist:linux": "node scripts/build-native.js && npm run backend:build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^2.14.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.18.0",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^12.4.0"
  },
  "build": {
    "appId": "com.screengd.tally",
    "productName": "Tally",
    "copyright": "Copyright © 2026 Screen",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "app/**/*",
      "backend/tally-backend*",
      "build/*.png",
      "native/media/build/Release/*.node",
      "package.json"
    ],
    "asarUnpack": [
      "native/media/build/Release/*.node",
      "backend/tally-backend*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Tally-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon-1024.png",
      "category": "public.app-category.productivity",
      "artifactName": "Tally-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ],
      "icon": "build/icon-1024.png",
      "category": "Utility",
      "artifactName": "Tally-${version}-linux-${arch}.${ext}",
      "maintainer": "Screen <228304862+screen-gd@users.noreply.github.com>",
      "synopsis": "Local screen-time tracker: which app and which website took your day."
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tally",
      "uninstallDisplayName": "Tally",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "screen-gd",
        "repo": "screen-time",
        "releaseType": "release"
      }
    ]
  },
  "allowScripts": {
    "electron@40.10.6": true,
    "koffi@2.16.3": true,
    "electron-winstaller@5.4.0": true
  }
}
